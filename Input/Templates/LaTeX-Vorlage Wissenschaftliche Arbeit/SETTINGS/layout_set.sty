%sectionlevel und subsectionlevel gibt es nicht mehr, die wurden mit scrpage2 abgeschafft.
%was die vernünftige Nachfolge ist, habe ich nicht herausgefunden...
% Hotfix: use numbers instead of sectionlevel
\setcounter{tocdepth}{1}%{\sectionlevel}										% nur bis 1.1/1.2/... ins Inhaltsvz.
\setcounter{secnumdepth}{2}%{\subsectionlevel}   								% Kapitel-Nummerierung nur bis 1.1.1/ 1.1.2/...
