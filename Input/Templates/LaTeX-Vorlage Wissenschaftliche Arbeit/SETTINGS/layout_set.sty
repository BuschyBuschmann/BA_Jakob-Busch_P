\widowpenalty 					= 10000										% Wen's interessiert:
\displaywidowpenalty 			= 10000										% http://de.wikipedia.org/wiki/Hurenkind_und_Schusterjunge
\interlinepenalty 				= 5000
\relpenalty						= 5000
